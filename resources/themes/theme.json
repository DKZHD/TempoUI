{
  "Globals": {
    "Default": [0.25, 0.25, 0.25, 1.0],
    "MainColor": [0.0, 0.9, 1.0, 1.0]
  },

  "Bordered Box": {
    "Inner Color": "$Default",
    "Outline Color": [1.0, 1.0, 1.0, 1.0],
    "Inset": 1.0,
    "Radius": [15, 15, 15, 15]
  },
  "Button": {
    "Default Color": [0.3, 0.3, 0.3, 1.0],
    "Hover Color": "$MainColor",
    "Click Color": [0.0, 0.7, 0.8, 1.0],
    "Radius": [10, 10, 10, 10]
  },
  "Checkbox": {
    "Check Color": [0, 0, 0, 1],
    "Hover Color": [0.2, 0.2, 0.2, 0.4],
    "Background Color": [0.8, 0.8, 0.8, 1.0],
    "Radius": [15, 15, 15, 15]
  },
  "GraphView": {
    "Node Color": "$MainColor",
